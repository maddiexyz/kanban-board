# Application Settings
PROJECT_NAME="Real-Time Collaborative Kanban"
API_V1_STR="/api"

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:password@127.0.0.1:5432/kanban_board"

# Redis Cache & PubSub
REDIS_URL="redis://127.0.0.1:6379/0"

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
